# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจาก LINE Developers Console
# สร้าง Provider + Channel ประเภท Messaging API ใหม่แยกต่างหากสำหรับ KonKai (ไม่ใช้ channel เดิมของบอทอื่น)

CHANNEL_ACCESS_TOKEN=
CHANNEL_SECRET=

# สร้าง LIFF app ในแท็บ LIFF ของ channel เดียวกันนี้ แล้วเอา LIFF ID มาใส่ที่นี่
# Endpoint URL ของ LIFF app ต้องชี้มาที่ https://<public-url>/  (เว็บนี้เอง)
LIFF_ID=

PORT=3000
