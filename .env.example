# Copy this file to .env for local reference. In production these are set as
# Netlify environment variables (netlify env:set), not committed here.

# LINE Developers Console > KonKai channel > Messaging API tab
CHANNEL_ACCESS_TOKEN=
CHANNEL_SECRET=

# Google Cloud service account (Sheets API) with Editor access on the sheet
# that stores group-scoped session data. The value is the service account's
# JSON key file, base64-encoded onto a single line.
GOOGLE_SERVICE_ACCOUNT_KEY_B64=
GOOGLE_SHEET_ID=
